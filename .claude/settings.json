{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "Read(./config/credentials.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Write(./.env*)",
      "Write(**/.env*)",
      "Write(./secrets/**)",
      "Write(**/secrets/**)",
      "Bash(rm -rf .git)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)"
    ],
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rishikawa/ghq/github.com/stoneream/toolbox/codex-play-notify.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rishikawa/ghq/github.com/stoneream/toolbox/codex-play-notify.sh"
          }
        ]
      }
    ]
  }
}
